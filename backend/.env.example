# Nomes das variáveis da API. Preencha os valores no arquivo .env local (não versionado).
# Não coloque segredos neste arquivo.

DATABASE_URL=
JWT_SECRET=
PORT=
API_GLOBAL_PREFIX=

# Opcional: connection string do banco publicado (Supabase) só para testes automatizados.
# Se estiver vazia, os testes que dependem dela devem parar sem usar DATABASE_URL local.
TEST_DATABASE_URL=
